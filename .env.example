ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://phanda:phanda@localhost:5433/phanda
REDIS_URL=redis://localhost:6379/0

# Required in every environment -- see Settings.assert_safe_for_environment(),
# which refuses to boot at all while this is unset or still the insecure
# default. Generate a real secret with
# `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=60

# Comma-separated Google OAuth client IDs this backend accepts as an
# audience (typically the Android client ID; add a web client ID too if one
# is ever created). Leave blank to disable POST /auth/google (it 503s).
GOOGLE_OAUTH_CLIENT_IDS=

# Comma-separated origins allowed to make cross-origin requests (browser
# clients only -- Android/other native clients aren't subject to CORS).
# Defaults to the two localhost variants if unset, so phanda-web's dev
# server works with no configuration. Add your machine's LAN IP here
# (e.g. http://10.1.2.3:5173) to test from a phone over Wi-Fi -- don't
# hardcode it in code, since it changes per network.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MONTHLY_FREE_CV_TAILOR=3
MONTHLY_FREE_SKILL_GAP_ROADMAP=3
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=za
ADZUNA_INGESTION_MAX_PAGES=20
ADZUNA_INGESTION_RESULTS_PER_PAGE=50
# Himalayas remote-jobs ingestion. Public API, no key or account required --
# there is intentionally no HIMALAYAS_* secret. 20 listings per page is the
# API's own maximum, so this bounds a run at 10 * 20 = 200 listings.
HIMALAYAS_INGESTION_MAX_PAGES=10
LISTING_STALE_AFTER_DAYS=7
# Required to call POST /ingestion/adzuna/run (header X-Ingestion-Secret) —
# manual/operator use only; the scheduled Celery beat job does not need it.
INGESTION_TRIGGER_SECRET=

S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=af-south-1
LOCAL_STORAGE_PATH=.phanda-storage

AI_PROVIDER=gemini
AI_MODEL=gemini-3.6-flash
GEMINI_API_KEY=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
AI_TIMEOUT_SECONDS=60
PREMIUM_MONTHLY_CV_TAILOR=100
TAILORING_RESERVATION_MINUTES=30
TAILORING_MAX_ATTEMPTS=3
CV_EXTRACTION_LEASE_MINUTES=15
CV_EXTRACTION_MAX_ATTEMPTS=3

EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
EMAIL_FROM=applications@phanda.example

REVENUECAT_WEBHOOK_SECRET=
